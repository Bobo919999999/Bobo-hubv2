local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer

if CoreGui:FindFirstChild("CandyESPUI") then
    CoreGui.CandyESPUI:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "CandyESPUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = CoreGui

-- Notification Container
local notifHolder = Instance.new("Frame")
notifHolder.Name = "NotifHolder"
notifHolder.Size = UDim2.new(0, 250, 0, 300)
notifHolder.Position = UDim2.new(1, -260, 1, -310)
notifHolder.BackgroundTransparency = 1
notifHolder.Parent = screenGui

local notifLayout = Instance.new("UIListLayout")
notifLayout.SortOrder = Enum.SortOrder.LayoutOrder
notifLayout.Padding = UDim.new(0, 6)
notifLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
notifLayout.Parent = notifHolder

local function notify(itemName)
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 0, 0, 40)
    card.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    card.BorderSizePixel = 0
    card.Parent = notifHolder

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = card

    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(40, 40, 40)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(10, 10, 10))
    })
    gradient.Rotation = 90
    gradient.Parent = card

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -10, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Text = "🍬 Spawned: " .. itemName
    label.Parent = card

    task.delay(4, function()
        local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local tween = TweenService:Create(card, tweenInfo, {BackgroundTransparency = 1})
        local textTween = TweenService:Create(label, tweenInfo, {TextTransparency = 1})
        tween:Play()
        textTween:Play()
        tween.Completed:Connect(function()
            card:Destroy()
        end)
    end)
end

local ESP_Folder = Instance.new("Folder")
ESP_Folder.Name = "CandyESP_Folder"
ESP_Folder.Parent = CoreGui

local TrackedObjects = {}

local function cleanString(str)
    return str:lower():gsub("[%s%p]", "")
end

local function isPlayerRelated(obj)
    local ancestor = obj
    while ancestor and ancestor ~= Workspace do
        if Players:GetPlayerFromCharacter(ancestor) or ancestor:IsA("Player") then
            return true
        end
        ancestor = ancestor.Parent
    end
    return false
end

local function isCosmeticOrShop(obj)
    local ancestor = obj
    while ancestor and ancestor ~= Workspace do
        local aname = ancestor.Name:lower()
        if aname:find("shop") or aname:find("store") or aname:find("cosmetic") or 
           aname:find("accessory") or aname:find("hat") or aname:find("display") or 
           aname:find("merchant") or aname:find("booth") then
            return true
        end
        ancestor = ancestor.Parent
    end
    return false
end

local function getAdorneePart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart end
        return obj:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function createESP(obj, isBasket)
    if TrackedObjects[obj] then return end
    
    local targetPart = getAdorneePart(obj)
    if not targetPart then return end
    
    TrackedObjects[obj] = true

    local bb = Instance.new("BillboardGui")
    bb.Name = "ESP_" .. obj.Name
    bb.Adornee = targetPart
    bb.AlwaysOnTop = true
    bb.Size = UDim2.new(0, 120, 0, 45)
    bb.StudsOffset = Vector3.new(0, 3.5, 0)
    bb.Parent = ESP_Folder

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BorderSizePixel = 0
    frame.Parent = bb

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = frame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.Text = obj.Name
    label.Parent = frame

    if isBasket then
        -- Dark Gray with Black Gradient for CandyBasket
        frame.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        label.TextColor3 = Color3.fromRGB(255, 255, 255)

        local blackGradient = Instance.new("UIGradient")
        blackGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(70, 70, 70)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0))
        })
        blackGradient.Rotation = 90
        blackGradient.Parent = frame
    else
        -- Rainbow Gradient for other items
        frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        label.TextColor3 = Color3.fromRGB(255, 255, 255)

        local rainbowGradient = Instance.new("UIGradient")
        rainbowGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
            ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 165, 0)),
            ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 255, 0)),
            ColorSequenceKeypoint.new(0.6, Color3.fromRGB(0, 255, 0)),
            ColorSequenceKeypoint.new(0.8, Color3.fromRGB(0, 0, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(238, 130, 238))
        })
        rainbowGradient.Parent = frame

        task.spawn(function()
            while bb and bb.Parent do
                rainbowGradient.Rotation = (rainbowGradient.Rotation + 4) % 360
                task.wait(0.03)
            end
        end)
    end

    obj.AncestryChanged:Connect(function(_, parent)
        if not parent then
            TrackedObjects[obj] = nil
            bb:Destroy()
        end
    end)
end

local function checkAndApply(obj, isNewSpawn)
    if obj:IsA("BasePart") or obj:IsA("Model") then
        if isPlayerRelated(obj) or isCosmeticOrShop(obj) then return end
        
        local clean = cleanString(obj.Name)
        
        -- Matches candybasket, candybag, candybowl, pumpkin regardless of spacing/case
        if clean:find("candybasket") or clean:find("candybag") or clean:find("candybowl") or clean == "pumpkin" then
            
            -- Wait up to 1 second for ProximityPrompt to register if it loads dynamically
            local prompt = obj:FindFirstChildOfClass("ProximityPrompt", true)
            if not prompt then
                task.wait(0.5)
                prompt = obj:FindFirstChildOfClass("ProximityPrompt", true)
            end

            if prompt then
                local actionText = (prompt.ActionText or ""):lower()
                if actionText:find("buy") or actionText:find("equip") or actionText:find("try") or actionText:find("exchange") then
                    return
                end

                local isBasket = clean:find("candybasket") ~= nil
                createESP(obj, isBasket)

                if isNewSpawn then
                    notify(obj.Name)
                end
            end
        end
    end
end

-- Initial map scan
for _, obj in ipairs(Workspace:GetDescendants()) do
    task.spawn(checkAndApply, obj, false)
end

-- Live spawn listener
Workspace.DescendantAdded:Connect(function(obj)
    task.spawn(checkAndApply, obj, true)
end)
