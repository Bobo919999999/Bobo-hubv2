local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

if CoreGui:FindFirstChild("CandyFarmCore") then
    CoreGui.CandyFarmCore:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "CandyFarmCore"
screenGui.ResetOnSpawn = false
screenGui.Parent = CoreGui

local button = Instance.new("TextButton")
button.Size = UDim2.new(0, 200, 0, 50)
button.Position = UDim2.new(0.5, -100, 0.1, 0)
button.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
button.TextColor3 = Color3.fromRGB(255, 140, 0)
button.Font = Enum.Font.GothamBold
button.TextSize = 13
button.Text = "🍬 Targets: 0 | OFF"
button.Active = true
button.Draggable = true
button.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = button

local AutoWalkEnabled = false

button.MouseButton1Click:Connect(function()
    AutoWalkEnabled = not AutoWalkEnabled
    button.TextColor3 = AutoWalkEnabled and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 140, 0)
end)

local function isPlayerItem(obj)
    return obj:FindFirstAncestorOfClass("Model") and Players:GetPlayerFromCharacter(obj:FindFirstAncestorOfClass("Model")) ~= nil
end

local function getValidPrompts()
    local prompts = {}
    for _, prompt in ipairs(Workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") and prompt.Enabled then
            local parent = prompt.Parent
            if parent and not isPlayerItem(parent) then
                table.insert(prompts, {Prompt = prompt, Parent = parent})
            end
        end
    end
    return prompts
end

-- Core Auto-Walk Loop
task.spawn(function()
    while task.wait(0.25) do
        pcall(function()
            local validPrompts = getValidPrompts()
            local count = #validPrompts
            
            button.Text = "🍬 Targets: " .. count .. " | " .. (AutoWalkEnabled and "ON" or "OFF")

            if AutoWalkEnabled and LocalPlayer.Character then
                local char = LocalPlayer.Character
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local humanoid = char:FindFirstChild("Humanoid")

                if hrp and humanoid then
                    local closestPos = nil
                    local shortestDist = math.huge
                    local targetPrompt = nil

                    for _, data in ipairs(validPrompts) do
                        local obj = data.Parent
                        if obj and obj.Parent then
                            local pos = obj:IsA("Model") and (obj.PrimaryPart and obj.PrimaryPart.Position or obj:GetPivot().Position) or obj.Position
                            local dist = (hrp.Position - pos).Magnitude
                            
                            if dist < shortestDist then
                                shortestDist = dist
                                closestPos = pos
                                targetPrompt = data.Prompt
                            end
                        end
                    end

                    if closestPos then
                        humanoid:MoveTo(closestPos)
                        
                        -- Fire prompt when close enough
                        if shortestDist <= 10 and targetPrompt then
                            fireproximityprompt(targetPrompt)
                        end
                    end
                end
            end
        end)
    end
end)
