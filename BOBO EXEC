local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui") -- CoreGui bypasses PlayerGui blocks in executors

local LocalPlayer = Players.LocalPlayer

-- Remove old instance if exists
if CoreGui:FindFirstChild("CandyFarmCore") then
    CoreGui.CandyFarmCore:Destroy()
end

-- Create ScreenGui in CoreGui so it always renders on mobile
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "CandyFarmCore"
screenGui.ResetOnSpawn = false
screenGui.Parent = CoreGui

-- Create a big, visible floating button
local button = Instance.new("TextButton")
button.Size = UDim2.new(0, 180, 0, 50)
button.Position = UDim2.new(0.5, -90, 0.1, 0)
button.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
button.TextColor3 = Color3.fromRGB(255, 140, 0)
button.Font = Enum.Font.GothamBold
button.TextSize = 14
button.Text = "🍬 AUTO-WALK: OFF"
button.Active = true
button.Draggable = true
button.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = button

local AutoWalkEnabled = false
local TargetList = {}

button.MouseButton1Click:Connect(function()
    AutoWalkEnabled = not AutoWalkEnabled
    if AutoWalkEnabled then
        button.Text = "🍬 AUTO-WALK: ON"
        button.TextColor3 = Color3.fromRGB(50, 255, 50)
    else
        button.Text = "🍬 AUTO-WALK: OFF"
        button.TextColor3 = Color3.fromRGB(255, 140, 0)
    end
end)

-- Scan Workspace for candy bowls
local function scan(obj)
    if obj:IsA("BasePart") or obj:IsA("Model") then
        local n = obj.Name:lower()
        if (n:find("candy") or n:find("bowl") or n:find("basket") or n:find("bucket") or n:find("pail") or n:find("treat")) and not n:find("pumpkin") then
            local parentName = obj.Parent and obj.Parent.Name:lower() or ""
            if not parentName:find("shop") and not parentName:find("display") then
                table.insert(TargetList, obj)
                obj.AncestryChanged:Connect(function(_, parent)
                    if not parent then
                        for i, v in ipairs(TargetList) do
                            if v == obj then
                                table.remove(TargetList, i)
                                break
                            end
                        end
                    end
                end)
            end
        end
    end
end

for _, obj in ipairs(Workspace:GetDescendants()) do
    scan(obj)
end

Workspace.DescendantAdded:Connect(scan)

-- Auto-walk Loop
task.spawn(function()
    while task.wait(0.3) do
        if AutoWalkEnabled then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    local humanoid = char.Humanoid
                    
                    local closestPos = nil
                    local shortestDist = math.huge
                    local targetObj = nil

                    for _, target in ipairs(TargetList) do
                        if target and target.Parent then
                            local pos = target:IsA("Model") and (target.PrimaryPart and target.PrimaryPart.Position or target:GetPivot().Position) or target.Position
                            local dist = (hrp.Position - pos).Magnitude
                            if dist < shortestDist then
                                shortestDist = dist
                                closestPos = pos
                                targetObj = target
                            end
                        end
                    end

                    if closestPos then
                        humanoid:MoveTo(closestPos)
                        local prompt = targetObj and (targetObj:FindFirstChildOfClass("ProximityPrompt", true))
                        if shortestDist <= 8 and prompt then
                            fireproximityprompt(prompt)
                        end
                    end
                end
            end)
        end
    end
end)
