local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

if CoreGui:FindFirstChild("CandyFarmCore") then
    CoreGui.CandyFarmCore:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "CandyFarmCore"
screenGui.ResetOnSpawn = false
screenGui.Parent = CoreGui

local button = Instance.new("TextButton")
button.Size = UDim2.new(0, 200, 0, 50)
button.Position = UDim2.new(0.5, -100, 0.1, 0)
button.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
button.TextColor3 = Color3.fromRGB(255, 140, 0)
button.Font = Enum.Font.GothamBold
button.TextSize = 13
button.Text = "🍬 Baskets: 0 | OFF"
button.Active = true
button.Draggable = true
button.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = button

local AutoWalkEnabled = false
local TargetList = {}
local ActiveTargets = {}

button.MouseButton1Click:Connect(function()
    AutoWalkEnabled = not AutoWalkEnabled
    button.TextColor3 = AutoWalkEnabled and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 140, 0)
end)

local function isPlayerRelated(obj)
    local ancestor = obj
    while ancestor and ancestor ~= Workspace do
        if Players:GetPlayerFromCharacter(ancestor) or ancestor:IsA("Player") then
            return true
        end
        ancestor = ancestor.Parent
    end
    return false
end

local function isMapDecorationOrShop(obj)
    local name = obj.Name:lower()
    
    -- Ban static map decorations, meshes, and pumpkin props
    if name:find("decoration") or name:find("prop") or name:find("mesh") or name:find("static") or 
       name:find("pumpkin") or name:find("cosmetic") or name:find("hat") or name:find("head") then
        return true
    end

    -- Check parent folders for shops, merchants, or spirit stores
    local ancestor = obj
    while ancestor and ancestor ~= Workspace do
        local aname = ancestor.Name:lower()
        if aname:find("shop") or aname:find("store") or aname:find("merchant") or 
           aname:find("spirit") or aname:find("hallow") or aname:find("exchange") or 
           aname:find("booth") or aname:find("vendor") then
            return true
        end
        ancestor = ancestor.Parent
    end
    
    return false
end

local function scan(obj)
    if obj:IsA("BasePart") or obj:IsA("Model") then
        if isPlayerRelated(obj) then return end
        if isMapDecorationOrShop(obj) then return end
        
        local n = obj.Name:lower()
        
        -- Specifically target Candy Baskets / active collectible bowls while avoiding map props
        local isTargetItem = (n:find("basket") or (n:find("candy") and n:find("bowl"))) and not n:find("pumpkin")
        
        if isTargetItem then
            local prompt = obj:FindFirstChildOfClass("ProximityPrompt", true)
            if prompt then
                local actionText = (prompt.ActionText or ""):lower()
                local objectText = (prompt.ObjectText or ""):lower()
                
                -- Reject shop prompts, equips, or rewards
                if actionText:find("buy") or actionText:find("purchase") or actionText:find("equip") or 
                   actionText:find("try") or actionText:find("exchange") or actionText:find("trade") or 
                   actionText:find("talk") or objectText:find("shop") or objectText:find("token") then
                    return
                end

                if not ActiveTargets[obj] then
                    ActiveTargets[obj] = true
                    table.insert(TargetList, obj)

                    obj.AncestryChanged:Connect(function(_, parent)
                        if not parent then
                            ActiveTargets[obj] = nil
                            for i, v in ipairs(TargetList) do
                                if v == obj then
                                    table.remove(TargetList, i)
                                    break
                                end
                            end
                        end
                    end)
                end
            end
        end
    end
end

for _, obj in ipairs(Workspace:GetDescendants()) do
    scan(obj)
end

Workspace.DescendantAdded:Connect(scan)

-- Core Auto-Walk Loop
task.spawn(function()
    while task.wait(0.2) do
        pcall(function()
            local count = #TargetList
            button.Text = "🍬 Baskets: " .. count .. " | " .. (AutoWalkEnabled and "ON" or "OFF")

            if AutoWalkEnabled and LocalPlayer.Character then
                local char = LocalPlayer.Character
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local humanoid = char:FindFirstChild("Humanoid")

                if hrp and humanoid then
                    local closestPos = nil
                    local shortestDist = math.huge
                    local targetObj = nil

                    for _, target in ipairs(TargetList) do
                        if target and target.Parent then
                            local pos = target:IsA("Model") and (target.PrimaryPart and target.PrimaryPart.Position or target:GetPivot().Position) or target.Position
                            local dist = (hrp.Position - pos).Magnitude
                            if dist < shortestDist then
                                shortestDist = dist
                                closestPos = pos
                                targetObj = target
                            end
                        end
                    end

                    if closestPos then
                        humanoid:MoveTo(closestPos)
                        if targetObj then
                            local prompt = targetObj:FindFirstChildOfClass("ProximityPrompt", true)
                            if shortestDist <= 10 and prompt then
                                fireproximityprompt(prompt)
                            end
                        end
                    end
                end
            end
        end)
    end
end)
