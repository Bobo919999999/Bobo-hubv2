local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local ProcessedCandies = {}

-- Function to create visual indicators (Highlight + Billboard Label)
local function createCandyESP(candy)
    if not candy or ProcessedCandies[candy] then return end
    
    -- Highlight effect around the candy (visible through walls)
    local highlight = Instance.new("Highlight")
    highlight.Name = "CandyHighlight"
    highlight.Adornee = candy
    highlight.FillColor = Color3.fromRGB(255, 105, 180) -- Bright Pink
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.4
    highlight.OutlineTransparency = 0
    highlight.Parent = candy

    -- Floating text display above the candy
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "CandyBillboard"
    billboard.Adornee = candy
    billboard.Size = UDim2.new(0, 160, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 14
    label.Text = "🍬 " .. candy.Name
    label.Parent = billboard

    billboard.Parent = candy
    ProcessedCandies[candy] = true

    -- Clean up tracking when collected or removed
    candy.Destroying:Connect(function()
        ProcessedCandies[candy] = nil
    end)
end

-- Scan Workspace for candy instances
local function scanForCandies()
    for _, object in ipairs(Workspace:GetDescendants()) do
        if object:IsA("BasePart") or object:IsA("Model") then
            local lowerName = object.Name:lower()
            if lowerName:find("candy") or lowerName:find("sweet") or lowerName:find("treat") then
                if not object:FindFirstChild("CandyHighlight") then
                    createCandyESP(object)
                end
            end
        end
    end
end

-- Run immediate scan and keep monitoring for continuous spawns
scanForCandies()

task.spawn(function()
    while true do
        scanForCandies()
        task.wait(2)
    end
end)

-- Detect new candy drops instantly
Workspace.DescendantAdded:Connect(function(descendant)
    local lowerName = descendant.Name:lower()
    if lowerName:find("candy") or lowerName:find("sweet") or lowerName:find("treat") then
        task.wait(0.1)
        createCandyESP(descendant)
    end
end)
