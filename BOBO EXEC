local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

if CoreGui:FindFirstChild("CandyFarmCore") then
    CoreGui.CandyFarmCore:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "CandyFarmCore"
screenGui.ResetOnSpawn = false
screenGui.Parent = CoreGui

local button = Instance.new("TextButton")
button.Size = UDim2.new(0, 180, 0, 50)
button.Position = UDim2.new(0.5, -90, 0.1, 0)
button.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
button.TextColor3 = Color3.fromRGB(255, 140, 0)
button.Font = Enum.Font.GothamBold
button.TextSize = 14
button.Text = "🍬 AUTO-WALK: OFF"
button.Active = true
button.Draggable = true
button.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = button

local AutoWalkEnabled = false
local TargetList = {}

button.MouseButton1Click:Connect(function()
    AutoWalkEnabled = not AutoWalkEnabled
    if AutoWalkEnabled then
        button.Text = "🍬 AUTO-WALK: ON"
        button.TextColor3 = Color3.fromRGB(50, 255, 50)
    else
        button.Text = "🍬 AUTO-WALK: OFF"
        button.TextColor3 = Color3.fromRGB(255, 140, 0)
    end
end)

local function scan(obj)
    if obj:IsA("BasePart") or obj:IsA("Model") then
        local n = obj.Name:lower()
        if (n:find("candy") or n:find("bowl") or n:find("basket") or n:find("bucket") or n:find("pail") or n:find("treat")) and not n:find("pumpkin") then
            local prompt = obj:FindFirstChildOfClass("ProximityPrompt", true)
            if prompt then
                -- Check prompt text to ignore shop purchases / exchanges
                local actionText = (prompt.ActionText or ""):lower()
                local objectText = (prompt.ObjectText or ""):lower()
                
                if actionText:find("buy") or actionText:find("purchase") or actionText:find("exchange") or 
                   objectText:find("shop") or objectText:find("store") or objectText:find("token") then
                    return 
                end

                table.insert(TargetList, obj)
                obj.AncestryChanged:Connect(function(_, parent)
                    if not parent then
                        for i, v in ipairs(TargetList) do
                            if v == obj then
                                table.remove(TargetList, i)
                                break
                            end
                        end
                    end
                end)
            end
        end
    end
end

for _, obj in ipairs(Workspace:GetDescendants()) do
    scan(obj)
end

Workspace.DescendantAdded:Connect(scan)

-- Auto-walk Loop
task.spawn(function()
    while task.wait(0.3) do
        if AutoWalkEnabled then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    local humanoid = char.Humanoid
                    
                    local closestPos = nil
                    local shortestDist = math.huge
                    local targetPrompt = nil

                    for _, target in ipairs(TargetList) do
                        if target and target.Parent then
                            local pos = target:IsA("Model") and (target.PrimaryPart and target.PrimaryPart.Position or target:GetPivot().Position) or target.Position
                            local dist = (hrp.Position - pos).Magnitude
                            if dist < shortestDist then
                                shortestDist = dist
                                closestPos = pos
                                targetPrompt = target:FindFirstChildOfClass("ProximityPrompt", true)
                            end
                        end
                    end

                    if closestPos then
                        humanoid:MoveTo(closestPos)
                        if shortestDist <= 8 and targetPrompt then
                            local aText = (targetPrompt.ActionText or ""):lower()
                            if not aText:find("buy") and not aText:find("purchase") then
                                fireproximityprompt(targetPrompt)
                            end
                        end
                    end
                end
            end)
        end
    end
end)
