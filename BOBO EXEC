local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

if PlayerGui:FindFirstChild("CandyESPGui") then
    PlayerGui.CandyESPGui:Destroy()
end

local Settings = {
    ESPEnabled = true,
    ShowDistance = true,
    TextSize = 12,
    MaxDistance = 300,
    Color = Color3.fromRGB(255, 105, 180)
}

local ProcessedCandies = {}
local ActiveBillboards = {}
local ActiveLabels = {}

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "CandyESPGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = PlayerGui

-- Simple toggle button to confirm UI loads
local toggleButton = Instance.new("TextButton")
toggleButton.Size = UDim2.new(0, 120, 0, 35)
toggleButton.Position = UDim2.new(0, 15, 0.3, 0)
toggleButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
toggleButton.TextColor3 = Color3.fromRGB(255, 105, 180)
toggleButton.Font = Enum.Font.SourceSansBold
toggleButton.TextSize = 14
toggleButton.Text = "🍬 ESP: ON"
toggleButton.Parent = screenGui

toggleButton.MouseButton1Click:Connect(function()
    Settings.ESPEnabled = not Settings.ESPEnabled
    toggleButton.Text = Settings.ESPEnabled and "🍬 ESP: ON" or "🍬 ESP: OFF"
    for _, billboard in pairs(ActiveBillboards) do
        if billboard then billboard.Enabled = Settings.ESPEnabled end
    end
end)

local function createESP(target)
    if not target or ProcessedCandies[target] then return end
    ProcessedCandies[target] = true

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "CandyBillboard"
    billboard.Adornee = target
    billboard.Size = UDim2.new(0, 120, 0, 35)
    billboard.StudsOffset = Vector3.new(0, 2, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = Settings.ESPEnabled

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Settings.Color
    label.TextStrokeTransparency = 0.5
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = Settings.TextSize
    label.Text = "🍬 " .. target.Name
    label.Parent = billboard

    billboard.Parent = target
    ActiveBillboards[target] = billboard
    ActiveLabels[target] = label

    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not target or not target.Parent or not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            if billboard then billboard:Destroy() end
            if connection then connection:Disconnect() end
            ProcessedCandies[target] = nil
            ActiveBillboards[target] = nil
            ActiveLabels[target] = nil
            return
        end

        if not Settings.ESPEnabled then return end

        local hrp = LocalPlayer.Character.HumanoidRootPart
        local pos = target:IsA("Model") and (target.PrimaryPart and target.PrimaryPart.Position or target:GetPivot().Position) or target.Position
        local dist = math.floor((hrp.Position - pos).Magnitude)

        if dist > Settings.MaxDistance then
            billboard.Enabled = false
        else
            billboard.Enabled = Settings.ESPEnabled
            if Settings.ShowDistance then
                label.Text = "🍬 " .. target.Name .. "\n[" .. dist .. "s]"
            else
                label.Text = "🍬 " .. target.Name
            end
        end
    end)
end

local function checkObject(obj)
    if obj:IsA("BasePart") or obj:IsA("Model") then
        local name = obj.Name:lower()
        -- Added more generic checks just in case
        if name:find("candy") or name:find("sweet") or name:find("treat") or name:find("spawn") then
            createESP(obj)
        end
    end
end

-- Scan descendants instead of just children (catches items inside folders)
for _, obj in ipairs(Workspace:GetDescendants()) do
    checkObject(obj)
end

Workspace.DescendantAdded:Connect(checkObject)
print("Candy ESP Loaded Successfully!")
