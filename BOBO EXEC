-- Helper Functions
local function isPlayerItem(obj)
    return obj:FindFirstAncestorOfClass("Model") and Players:GetPlayerFromCharacter(obj:FindFirstAncestorOfClass("Model")) ~= nil
end

local function getTargetPart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") or obj:GetPivot().Position
    end
    return nil
end

local function addESP(target, prompt)
    if not target or ActiveTargets[target] or isPlayerItem(target) then return end
    
    local part = getTargetPart(target)
    if not part then return end

    ActiveTargets[target] = {Part = part, Prompt = prompt}

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "CandyTag"
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 120, 0, 30)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.Adornee = part

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Colors[currentColorIdx].Color
    label.TextStrokeTransparency = 0.2
    label.Font = Enum.Font.GothamBold
    label.TextSize = 12
    label.Text = "🍬 Candy Bowl"
    label.Parent = billboard

    billboard.Parent = part
    Billboards[target] = billboard

    -- Dynamic Cleanup when collected or destroyed
    local conn
    conn = target.AncestryChanged:Connect(function(_, parent)
        if not parent then
            if billboard then billboard:Destroy() end
            ActiveTargets[target] = nil
            Billboards[target] = nil
            conn:Disconnect()
        end
    end)
end

-- Scanning Logic (Focuses on Interactive Collectibles)
local function checkObject(obj)
    if obj:IsA("ProximityPrompt") then
        local parent = obj.Parent
        if parent and not isPlayerItem(parent) then
            addESP(parent, obj)
        end
    end
end

-- Scan existing Workspace
for _, obj in ipairs(Workspace:GetDescendants()) do
    checkObject(obj)
end

-- Listen for new spawns
Workspace.DescendantAdded:Connect(function(child)
    checkObject(child)
end)

-- Render Loop for Distances and ESP Toggle
RunService.RenderStepped:Connect(function()
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = LocalPlayer.Character.HumanoidRootPart

    for target, data in pairs(ActiveTargets) do
        local billboard = Billboards[target]
        if billboard and billboard:FindFirstChildOfClass("TextLabel") then
            if ESPEnabled then
                billboard.Enabled = true
                local pos = typeof(data.Part) == "Vector3" and data.Part or data.Part.Position
                local dist = math.floor((hrp.Position - pos).Magnitude)
                billboard.TextLabel.Text = "🍬 Candy [" .. dist .. "m]"
            else
                billboard.Enabled = false
            end
        end
    end
end)

